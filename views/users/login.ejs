<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Login - Tidder</title>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans&display=swap" rel="stylesheet">
  <style>
    :root {
      --reddit-orange: #ff4500;
      --background: #f6f7f8;
      --text: #1c1c1c;
      --button-hover: #d93a00;
    }

    * {
      box-sizing: border-box;
      font-family: 'Noto Sans', sans-serif;
    }

    body {
      background-color: var(--background);
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      color: var(--text);
    }

    header {
      background-color: white;
      padding: 1rem 2rem;
      border-bottom: 1px solid #ddd;
      text-align: center;
    }

    header h1 {
      color: var(--reddit-orange);
      font-size: 2.5rem;
    }

    main {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 3rem 1rem;
    }

    form {
      background-color: white;
      padding: 2rem;
      border-radius: 10px;
      box-shadow: 0 0 10px rgba(0,0,0,0.05);
      width: 100%;
      max-width: 400px;
    }

    h2 {
      text-align: center;
      margin-bottom: 1.5rem;
    }

    label {
      display: block;
      margin-top: 1rem;
      font-weight: bold;
    }

    input {
      width: 100%;
      padding: 0.5rem;
      margin-top: 0.25rem;
      border: 1px solid #ccc;
      border-radius: 5px;
    }

    button {
      width: 100%;
      margin-top: 2rem;
      padding: 0.75rem;
      background-color: var(--reddit-orange);
      color: white;
      font-weight: bold;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }

    button:hover {
      background-color: var(--button-hover);
    }

    .error {
      color: red;
      margin-top: 1rem;
      text-align: center;
    }

    .footer-link {
      margin-top: 1rem;
      text-align: center;
      font-size: 0.95rem;
    }

    footer {
      text-align: center;
      padding: 1rem;
      background-color: #fff;
      border-top: 1px solid #ddd;
    }
  </style>
</head>
<body>

  <header>
    <h1>Tidder</h1>
  </header>

  <main>
    <form method="POST" action="/users/login" autocomplete="off">
      <h2>Login</h2>

      <label>Email</label>
      <input type="email" name="email" required>

      <label>Password</label>
      <input type="password" name="password" required>

      <button type="submit">Log In</button>

      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>

      <div class="footer-link">
        Don't have an account? <a href="/users/register">Register</a>
      </div>
    </form>
  </main>

  <footer>
    <p>2025 • Tidder By Dhea & Haritz</p>
  </footer>

</body>
</html>
